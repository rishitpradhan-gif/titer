{
  "openapi": "3.1.0",
  "info": {
    "title": "Titer private assay API",
    "version": "1.0.0",
    "description": "Local/private Node service. The public Vercel site does not host this API. All results require scientific review."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4458"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Create locally with node scripts/key.mjs create LABEL DAYS"
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "description": "Original declared assay fields; see README for exact unit and context rules.",
        "required": [
          "id",
          "compound",
          "endpoint",
          "value",
          "unit"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "compound": {
            "type": [
              "string",
              "number"
            ]
          },
          "endpoint": {
            "type": [
              "string",
              "number"
            ]
          },
          "relation": {
            "type": [
              "string",
              "number"
            ]
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "unit": {
            "type": [
              "string",
              "number"
            ]
          },
          "mw_g_mol": {
            "type": [
              "string",
              "number"
            ]
          },
          "target": {
            "type": [
              "string",
              "number"
            ]
          },
          "organism": {
            "type": [
              "string",
              "number"
            ]
          },
          "system": {
            "type": [
              "string",
              "number"
            ]
          },
          "protocol": {
            "type": [
              "string",
              "number"
            ]
          },
          "temperature_C": {
            "type": [
              "string",
              "number"
            ]
          },
          "pH": {
            "type": [
              "string",
              "number"
            ]
          },
          "incubation_min": {
            "type": [
              "string",
              "number"
            ]
          },
          "substrate_nM": {
            "type": [
              "string",
              "number"
            ]
          },
          "enzyme_nM": {
            "type": [
              "string",
              "number"
            ]
          },
          "source": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "additionalProperties": {
          "type": [
            "string",
            "number"
          ]
        },
        "maxProperties": 40
      }
    }
  },
  "paths": {
    "/api/v1/analyze": {
      "post": {
        "operationId": "analyzeAssays",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "summary": "Normalize endpoints and audit declared context against a reference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csv": {
                    "type": "string"
                  },
                  "records": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/Record"
                    }
                  },
                  "reference_index": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "csv"
                    ],
                    "not": {
                      "required": [
                        "records"
                      ]
                    }
                  },
                  {
                    "required": [
                      "records"
                    ],
                    "not": {
                      "required": [
                        "csv"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report: schema, engine, summary, rows, policy, reference_index, reference_id and provenance. Invalid scientific rows remain explicit with null outputs."
          },
          "400": {
            "description": "Malformed input"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "405": {
            "description": "Wrong method"
          },
          "413": {
            "description": "Payload over 512 KiB"
          },
          "415": {
            "description": "JSON content type required"
          },
          "429": {
            "description": "Per-key limit exceeded"
          },
          "503": {
            "description": "Rate limiter capacity reached"
          }
        }
      }
    }
  }
}
